{
  "expo": {
    "name": "Feira da Casa",
    "slug": "feiradacasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "feiradacasa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feiradacasa.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Escanear cupom fiscal por foto",
        "NSPhotoLibraryUsageDescription": "Enviar cupom da galeria",
        "NSPhotoLibraryAddUsageDescription": "Salvar comprovantes na galeria",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.feiradacasa.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2F7C4C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso à galeria para anexar cupons.",
          "cameraPermission": "Permitir acesso à câmera para escanear cupons."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
